{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid)",
        ".validate": "$pin.matches(/^[0-9]{6}$/)",
        "meta": {
          ".validate": "newData.child('host').val() === auth.uid && newData.child('createdAt').isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $pin + '/meta').exists() && (!data.exists() || newData.exists())",
            ".validate": "newData.hasChildren(['name', 'avatar', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('avatar').isString() && newData.child('avatar').val().length <= 16 && newData.child('joinedAt').val() === now"
          }
        },
        "answers": {
          "$qkey": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $pin + '/players/' + $uid).exists() && root.child('rooms/' + $pin + '/state/phase').val() === 'question' && root.child('rooms/' + $pin + '/state/qkey').val() === $qkey",
              ".validate": "newData.hasChildren(['opt', 'at']) && newData.child('opt').isNumber() && newData.child('opt').val() >= 0 && newData.child('opt').val() < root.child('rooms/' + $pin + '/state/nOpts').val() && newData.child('at').val() === now"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "meta": {
          ".validate": "newData.hasChildren(['schema', 'updatedAt']) && newData.child('schema').isNumber() && newData.child('updatedAt').isNumber()"
        },
        "index": {
          "$key": {
            ".validate": "$key.length <= 64",
            "$id": { ".validate": "$id.length <= 400 && newData.isNumber()" }
          }
        },
        "items": {
          "$key": {
            ".validate": "$key.length <= 64",
            "$id": {
              ".validate": "$id.length <= 400 && newData.hasChildren(['t', 'by']) && (newData.hasChild('v') || newData.child('del').val() === true)",
              "t": { ".validate": "newData.isNumber()" },
              "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "v": { ".validate": "newData.isString() && newData.val().length <= 4000000" },
              "del": { ".validate": "newData.val() === true" },
              "$other": { ".validate": false }
            }
          }
        },
        "vault": {
          ".validate": "newData.hasChildren(['v', 'kdf', 'iter', 'salt', 'iv', 'ct', 't', 'by'])",
          "v": { ".validate": "newData.isNumber()" },
          "kdf": { ".validate": "newData.val() === 'PBKDF2-SHA256'" },
          "iter": { ".validate": "newData.isNumber() && newData.val() >= 100000" },
          "salt": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "iv": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "ct": { ".validate": "newData.isString() && newData.val().length <= 20000" },
          "t": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
